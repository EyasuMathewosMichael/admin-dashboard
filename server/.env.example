# ============================================================================
# Admin Dashboard - Environment Configuration
# ============================================================================

# Server Configuration
# Port on which the Express server will run (default: 3001)
PORT=3001

# Node Environment (development, production, test)
NODE_ENV=development

# ============================================================================
# Database Configuration
# ============================================================================

# MongoDB Connection URI
# For MongoDB Atlas (recommended):
#   mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# For local MongoDB:
#   mongodb://localhost:27017/admin-dashboard
# 
# Steps to get MongoDB Atlas URI:
# 1. Create account at https://www.mongodb.com/cloud/atlas
# 2. Create a free cluster
# 3. Create a database user
# 4. Get connection string from "Connect" button
# 5. Replace <username>, <password>, and <cluster> with your values
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/admin-dashboard?retryWrites=true&w=majority

# ============================================================================
# Authentication Configuration
# ============================================================================

# JWT Secret Key
# Use a long, random string (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Keep this secret and never commit it to version control
JWT_SECRET=your-super-secret-key-here-change-in-production

# JWT Token Expiry (in seconds)
# Default: 86400 (24 hours)
JWT_EXPIRY=86400

# ============================================================================
# CORS Configuration
# ============================================================================

# CORS Origin (allowed domains)
# For development: * (allow all)
# For production: https://yourdomain.com
CORS_ORIGIN=*

# ============================================================================
# Email Configuration (Optional - for future use)
# ============================================================================

# SMTP Server
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ============================================================================
# Logging Configuration (Optional)
# ============================================================================

# Log Level (error, warn, info, debug)
# LOG_LEVEL=info

# ============================================================================
# Notes
# ============================================================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. Use strong, random values for JWT_SECRET in production
# 4. Keep all secrets secure and never share them
# 5. Use environment-specific values for different deployments
